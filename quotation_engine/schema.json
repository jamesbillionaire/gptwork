{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved quotation job v2",
  "type": "object",
  "required": ["schema_version", "brand", "template_id", "title", "quote_no", "date", "validity_days", "tax_treatment", "client", "prepared_by", "expected_total", "amount_words", "blocks"],
  "properties": {
    "schema_version": {"const": 2},
    "brand": {"enum": ["lavi", "lifes-awesome"]},
    "template_id": {"enum": ["LAVI-QUOTATION-2026.4", "LIFES-AWESOME-QUOTATION-2026.2"]},
    "title": {"type": "string", "minLength": 1},
    "quote_no": {"type": "string", "minLength": 1},
    "date": {"type": "string", "minLength": 1},
    "validity_days": {"type": "integer", "minimum": 1},
    "tax_treatment": {"enum": ["VAT Inclusive", "VAT Exclusive"]},
    "expected_total": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "amount_words": {"type": "string", "minLength": 1},
    "client": {"type": "object", "required": ["name", "address", "attention", "role", "location"]},
    "prepared_by": {"type": "object", "required": ["name", "role"]},
    "blocks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["heading", "paragraph", "note", "list", "table", "boq", "diagram", "total", "page_break", "callout"]}}},
    "signature": {"type": "null"}
  },
  "$comment": "Run quotation_engine.cli validate for semantic validation, arithmetic, explicit brand/template matching and source-data checks beyond this editor schema. Monetary values are decimal strings. Layout overrides are not supported."
}
